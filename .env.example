# Public origin used for canonical links, OpenGraph, robots.txt, and sitemap.xml.
SITE_URL=https://planner.example.com

# Local/demo builds may use localhost only when this is explicitly enabled.
SITE_URL_ALLOW_LOCALHOST=false

# Production Node/Kubernetes serving requires a metrics token unless local/demo
# unauthenticated metrics are explicitly allowed.
METRICS_BEARER_TOKEN=replace-with-a-random-token

# Optional OpenTelemetry collector endpoint for Kubernetes deployments.
OTEL_EXPORTER_OTLP_ENDPOINT=
