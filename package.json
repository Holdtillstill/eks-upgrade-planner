{
  "name": "eks-upgrade-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "data:check": "node scripts/sync-eks-data.js --check",
    "data:update": "node scripts/sync-eks-data.js --write",
    "generate:public-metadata": "node scripts/generate-public-metadata.js",
    "generate:edge-static": "node scripts/generate-edge-static-files.js",
    "check:public-readiness": "node scripts/check-public-readiness.mjs",
    "validate:actions-secrets": "node scripts/validate-actions-secrets.js",
    "validate:edge-security": "node scripts/validate-edge-security.js",
    "validate:static-hosting": "node scripts/validate-static-hosting.js",
    "validate:workflows": "node scripts/verify-workflows.mjs",
    "smoke:static-host": "node scripts/smoke-static-host.mjs",
    "smoke:browser-host": "node scripts/smoke-browser-host.mjs",
    "prerender": "node scripts/prerender-static.js",
    "prebuild": "SITE_URL=${SITE_URL:-https://eks-upgrade-planner.bozhi.dev} SITE_URL_BUILD_MODE=production npm run generate:public-metadata",
    "postbuild": "SITE_URL=${SITE_URL:-https://eks-upgrade-planner.bozhi.dev} SITE_URL_BUILD_MODE=production npm run prerender && npm run generate:edge-static",
    "build": "SITE_URL=${SITE_URL:-https://eks-upgrade-planner.bozhi.dev} npm run typecheck && SITE_URL=${SITE_URL:-https://eks-upgrade-planner.bozhi.dev} vite build",
    "lint": "eslint .",
    "test": "NODE_ENV=test vitest run",
    "preview": "vite preview",
    "start": "node server/index.js",
    "start:prod": "NODE_ENV=production node server/index.js",
    "smoke:local": "node server/smoke.js"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-external-links": "^3.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
